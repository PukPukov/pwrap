 static gboolean
+fd_is_connected_to_pwrap_proxy (FlatpakProxy *proxy,
+                               int           fd)
+{
+  int type;
+  socklen_t type_len = sizeof (type);
+  struct sockaddr_storage peer_address;
+  socklen_t peer_address_len = sizeof (peer_address);
+
+  if (getsockopt (fd, SOL_SOCKET, SO_TYPE, &type, &type_len) < 0)
+    {
+      /* Non-socket FDs are ordinary D-Bus capabilities.  Other inspection
+       * failures are ambiguous, so fail closed instead of forwarding them. */
+      return errno != ENOTSOCK;
+    }
+
+  if (type != SOCK_STREAM)
+    return FALSE;
+
+  if (getpeername (fd, (struct sockaddr *) &peer_address, &peer_address_len) < 0)
+    {
+      /* An unconnected socket cannot carry a pwrap proxy's authenticated bus
+       * connection. Unknown errors are treated as unsafe. */
+      return errno != ENOTCONN && errno != EINVAL;
+    }
+
+  if (peer_address.ss_family != AF_UNIX)
+    return FALSE;
+
+  {
+    const struct sockaddr_un *unix_address = (const struct sockaddr_un *) &peer_address;
+    gsize proxy_path_length = strlen (proxy->socket_path);
+    gsize path_offset = G_STRUCT_OFFSET (struct sockaddr_un, sun_path);
+
+    if (proxy_path_length >= sizeof (unix_address->sun_path) ||
+        peer_address_len != path_offset + proxy_path_length + 1 ||
+        memcmp (unix_address->sun_path, proxy->socket_path, proxy_path_length) != 0 ||
+        unix_address->sun_path[proxy_path_length] != '\0')
+      return FALSE;
+  }
+
+  return TRUE;
+}
+
+static gboolean
+fd_message_contains_proxy_socket (FlatpakProxy          *proxy,
+                                  GSocketControlMessage *message)
+{
+  GUnixFDList *fd_list;
+  int count;
+  int i;
+
+  if (!G_IS_UNIX_FD_MESSAGE (message))
+    return FALSE;
+
+  fd_list = g_unix_fd_message_get_fd_list (G_UNIX_FD_MESSAGE (message));
+  count = g_unix_fd_list_get_length (fd_list);
+  for (i = 0; i < count; i++)
+    {
+      GError *error = NULL;
+      int fd = g_unix_fd_list_get (fd_list, i, &error);
+      gboolean is_proxy_socket;
+
+      if (fd < 0)
+        {
+          g_clear_error (&error);
+          return TRUE;
+        }
+
+      is_proxy_socket = fd_is_connected_to_pwrap_proxy (proxy, fd);
+      close (fd);
+      if (is_proxy_socket)
+        return TRUE;
+    }
+
+  return FALSE;
+}
