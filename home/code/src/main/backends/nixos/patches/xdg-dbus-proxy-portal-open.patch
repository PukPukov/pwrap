+/* Trusted command-line policy. Empty means deny all open actions; NULL means
+ * this optional policy is not enabled. It never grants a D-Bus method itself. */
+gboolean
+flatpak_proxy_set_portal_open (FlatpakProxy *proxy, const char *schemes, GError **error)
+{
+  g_auto(GStrv) parsed = g_strsplit (schemes, ",", -1);
+  guint i;
+
+  if (proxy->portal_open_schemes != NULL)
+    goto invalid;
+  for (i = 0; parsed[i] != NULL; i++)
+    {
+      const char *p = parsed[i];
+      if (!g_ascii_islower (*p))
+        goto invalid;
+      for (p++; *p != 0; p++)
+        if (!g_ascii_islower (*p) && !g_ascii_isdigit (*p) &&
+            *p != '+' && *p != '-' && *p != '.')
+          goto invalid;
+    }
+  proxy->portal_open_schemes = g_steal_pointer (&parsed);
+  return TRUE;
+
+invalid:
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                       "Expected one lowercase URI scheme list");
+  return FALSE;
+}
+
+gboolean
+flatpak_proxy_set_portal_ask (FlatpakProxy *proxy, gboolean file, const char *value, GError **error)
+{
+  guint bit = file ? 1 : 2;
+  if ((proxy->portal_ask_configured & bit) != 0 ||
+      (!g_str_equal (value, "true") && !g_str_equal (value, "false")))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                           "Expected one true/false portal ask policy per operation");
+      return FALSE;
+    }
+  if (file) proxy->portal_file_ask = g_str_equal (value, "true");
+  else proxy->portal_uri_ask = g_str_equal (value, "true");
+  proxy->portal_ask_configured |= bit;
+  return TRUE;
+}
