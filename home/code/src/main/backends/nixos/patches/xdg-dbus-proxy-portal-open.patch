+/* Apply after ordinary method authorization and SCM_RIGHTS framing. Match by
+ * interface/member, not destination spelling: unique-owner aliases and omitted
+ * interfaces must not evade this policy. Only a bounded portal body is decoded;
+ * GLib preserves byte order, serials, flags and FD indices on reserialization. */
+static gboolean
+filter_portal_open (FlatpakProxyClient *client, Header *header, Buffer **buffer)
+{
+  FlatpakProxy *proxy = client->proxy;
+  g_autoptr(GDBusMessage) message = NULL;
+  g_autoptr(GVariant) options = NULL;
+  g_autofree guchar *blob = NULL;
+  g_autoptr(GUri) uri_info = NULL;
+  const char *scheme;
+  GVariant *body;
+  const char *parent, *uri = NULL;
+  int fd = -1;
+  GVariantDict dict;
+  gsize size;
+  Buffer *rewritten;
+  gboolean file = g_strcmp0 (header->member, "OpenFile") == 0;
+
+  if (proxy->portal_open_schemes == NULL || header->type != G_DBUS_MESSAGE_TYPE_METHOD_CALL)
+    return TRUE;
+  if (header->interface != NULL &&
+      !g_str_equal (header->interface, "org.freedesktop.portal.OpenURI"))
+    return TRUE;
+  if (header->interface == NULL && !file &&
+      g_strcmp0 (header->member, "OpenURI") != 0 &&
+      g_strcmp0 (header->member, "OpenDirectory") != 0)
+    return TRUE;
+  if (g_strcmp0 (header->path, "/org/freedesktop/portal/desktop") != 0 ||
+      (*buffer)->size > 65536)
+    return FALSE;
+
+  message = g_dbus_message_new_from_blob ((*buffer)->data, (*buffer)->size,
+                                         G_DBUS_CAPABILITY_FLAGS_UNIX_FD_PASSING, NULL);
+  if (message == NULL || (body = g_dbus_message_get_body (message)) == NULL)
+    return FALSE;
+
+  if (file)
+    {
+      GList *l;
+
+      if (!g_strv_contains ((const char * const *) proxy->portal_open_schemes, "file") ||
+          !g_variant_is_of_type (body, G_VARIANT_TYPE ("(sha{sv})")))
+        return FALSE;
+      g_variant_get (body, "(&sh@a{sv})", &parent, &fd, &options);
+      if (fd < 0 || (guint) fd >= header->unix_fds)
+        return FALSE;
+
+      /* update_socket_messages already checked and associated this exact FD
+       * list with this message. Keep both its indices and ancillary ownership. */
+      for (l = (*buffer)->control_messages; l != NULL; l = l->next)
+        if (G_IS_UNIX_FD_MESSAGE (l->data))
+          g_dbus_message_set_unix_fd_list (message,
+            g_unix_fd_message_get_fd_list (G_UNIX_FD_MESSAGE (l->data)));
+      if (g_dbus_message_get_num_unix_fds (message) != header->unix_fds)
+        return FALSE;
+
+    }
+  else
+    {
+      const char *p;
+      guint i;
+      if (g_strcmp0 (header->member, "OpenURI") != 0 || header->unix_fds != 0 ||
+          !g_variant_is_of_type (body, G_VARIANT_TYPE ("(ssa{sv})")))
+        return FALSE;  /* In particular OpenDirectory does not offer ask. */
+      g_variant_get (body, "(&s&s@a{sv})", &parent, &uri, &options);
+      if (strlen (uri) == 0 || strlen (uri) > 16384)
+        return FALSE;
+      for (p = uri; *p != 0; p++)
+        if ((guchar) *p < 32 || *p == 127)
+          return FALSE;
+      uri_info = g_uri_parse (uri, G_URI_FLAGS_NONE, NULL);
+      if (uri_info == NULL || (scheme = g_uri_get_scheme (uri_info)) == NULL ||
+          g_ascii_strcasecmp (scheme, "file") == 0)
+        return FALSE;  /* Files must use OpenFile's FD + preset chooser policy. */
+      if (g_ascii_strcasecmp (scheme, "http") == 0 || g_ascii_strcasecmp (scheme, "https") == 0)
+        {
+          if (g_uri_get_host (uri_info) == NULL || *g_uri_get_host (uri_info) == 0)
+            return FALSE;
+        }
+      else if (*g_uri_get_path (uri_info) == 0 &&
+               (g_uri_get_host (uri_info) == NULL || *g_uri_get_host (uri_info) == 0))
+        return FALSE;
+      for (i = 0; proxy->portal_open_schemes[i] != NULL; i++)
+        if (g_ascii_strcasecmp (scheme, proxy->portal_open_schemes[i]) == 0)
+          break;
+      if (proxy->portal_open_schemes[i] == NULL)
+        return FALSE;
+    }
+
+  /* Collapse duplicate/wrongly-typed asks and enforce the trusted preset, never
+   * a client's preference. Files and URI schemes have independent policies. */
+  g_variant_dict_init (&dict, options);
+  g_variant_dict_insert (&dict, "ask", "b", file ? proxy->portal_file_ask : proxy->portal_uri_ask);
+  g_dbus_message_set_body (message, file
+    ? g_variant_new ("(sh@a{sv})", parent, fd, g_variant_dict_end (&dict))
+    : g_variant_new ("(ss@a{sv})", parent, uri, g_variant_dict_end (&dict)));
+
+  blob = g_dbus_message_to_blob (message, &size, G_DBUS_CAPABILITY_FLAGS_UNIX_FD_PASSING, NULL);
+  if (blob == NULL || size > 65536)
+    return FALSE;
+  rewritten = buffer_new (size, NULL);
+  memcpy (rewritten->data, blob, size);
+  rewritten->pos = size;
+  rewritten->control_messages = (*buffer)->control_messages;
+  (*buffer)->control_messages = NULL;
+  buffer_unref (*buffer);
+  *buffer = rewritten;
+  return TRUE;
+}
